        "fragmentation_ref": "TLS-REC-002",
        "preserve_handshake_bytes": true,
        "buffer_application_writes": true,
        "fallback": "pass-through",
        "default_enabled": false
      },
      "execution_contract": "Buffers application writes until the first complete ClientHello TLS record is available, then splits at a bounded byte offset and emits the first and remaining fragments with independently configured TLS record legacy_version values. The handshake bytes remain byte-identical.",
