    {
      "profile_id": "TLS-REC-001",
      "name": "TLS outer record-version override",
      "family": "tls-record",
      "priority": "P0",
      "implementation_status": "implemented-in-xray-fork",
      "default_enabled": false,
      "config_format": "xray-finalmask-tls-record",
      "client_component": "Xray FinalMask",
      "requires": {
        "client": [
          "Xray parser and runtime support"
        ],
        "server": []
      },
      "parameters": {
        "record_types": [
          "handshake"
        ],
        "outer_version": "0x0303",
        "preserve_handshake_bytes": true,
        "apply_to": "first_complete_client_hello_record",
        "fallback": "pass-through",
        "max_record_bytes": 18432,
        "supported_outer_versions": [
          "0x0301",
          "0x0302",
          "0x0303"
        ],
        "buffer_application_writes": true
      },
      "execution_contract": "Buffers application writes until the first TLS record is complete, then rewrites only its legacy_version bytes. The handshake payload and transcript remain byte-identical.",
      "invariants": [
        "Do not change ClientHello handshake bytes or transcript",
        "Only mutate the outer TLS record legacy_version field",
        "Accept only outer versions 0x0301, 0x0302, and 0x0303",
        "Do not transform non-TLS, malformed, incomplete, or non-ClientHello records; flush an incomplete buffered prefix unchanged on close"
      ],
      "notes": "Implemented in the PattNG Xray fork; targeted tests pass on the implementation branch. Full cross-platform regression and live network compatibility must be verified separately. Version 0x0304 is not accepted by this implementation.",
      "validation": [
        "configuration-parse",
        "fragmented-application-writes",
        "record-header-only-mutation",
        "local-endpoint-handshake",
        "certificate-validation",
        "http-response-body"
      ],
      "implementation_commit": "371b7a52f94115ca6f6fc31c6a7c100ca0a74bc0"
    },
    {
      "profile_id": "TLS-REC-002",
      "name": "SNI-position-aware TLS record fragmentation",
      "family": "tls-record",
      "priority": "P0",
      "implementation_status": "implemented-in-xray-fork",
      "default_enabled": false,
      "config_format": "xray-finalmask-sni-fragment",
      "client_component": "Xray FinalMask",
      "requires": {
        "client": [
          "Xray incremental ClientHello parser"
        ],
        "server": []
      },
      "parameters": {
        "parser": "first-complete-clienthello-record",
        "boundaries": [
          "before_sni_extension",
          "inside_sni_extension_header",
          "inside_hostname",
          "after_sni_extension"
        ],
        "record_content_type": 22,
        "preserve_handshake_bytes": true,
        "max_fragments": 2,
        "inter_fragment_delay_ms": 0,
        "fallback": "pass-through",
        "sni_split_modes": {
          "before_sni_extension": "before-extension",
          "inside_sni_extension_header": "extension-header",
          "inside_hostname": "mid-hostname",
          "after_sni_extension": "after-extension"
        },
        "buffer_application_writes": true
      },
      "execution_contract": "Buffers application writes until the first TLS record is complete, parses the ClientHello SNI extension, and splits the record at one of four validated SNI-relative offsets. If ClientHello spans multiple TLS records, SNI is absent, the record is incomplete, or the selected offset leaves no bytes for a second record, the input passes through unchanged.",
      "invariants": [
        "Handle a ClientHello record delivered across multiple application writes",
        "Recompute both TLS record lengths",
        "Split only at a parsed SNI-relative offset",
        "Keep the reassembled handshake transcript byte-identical",
        "No inter-fragment delay is implemented"
      ],
      "notes": "The four SNI split offsets are implemented. This implementation does not reassemble a ClientHello spanning multiple TLS records and does not add configurable delays. Profiles remain disabled by default.",
      "validation": [
        "configuration-parse",
        "all-four-SNI-boundaries",
        "fragmented-application-writes",
        "record-length-recalculation",
        "handshake-byte-preservation",
        "local-endpoint-handshake",
        "certificate-validation"
      ],
      "implementation_commit": "371b7a52f94115ca6f6fc31c6a7c100ca0a74bc0"
    },
    {
